# Banco/Supabase — configure como segredo na Vercel; nunca comite valores reais.
POSTGRES_PRISMA_URL=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
SUPABASE_DB_URL=
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Segredo exclusivo para assinatura da sessão HttpOnly.
# Use pelo menos 32 bytes aleatórios em Preview e Production na Vercel.
SESSION_SECRET=

# Segredo interno do backend. O navegador autenticado NÃO precisa conhecer esta chave.
REMOTE_SYNC_KEY=
# Deixe false em produção. Só use chave legada em clientes antigos durante rollback controlado.
ALLOW_LEGACY_SYNC_KEY=false

# A interface HTML/CSS/JS é empacotada e servida pelo próprio backend Python deste repositório.
# Não existe fonte, URL ou repositório de frontend externo em produção.
SMG_FRONTEND_DIR=frontend

# WhatsApp Business Cloud API — configure apenas como segredos de Production na Vercel.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=lembrete_mensalidade_arte_de_aprender
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
CRON_SECRET=
