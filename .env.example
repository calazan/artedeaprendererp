# Neon/PostgreSQL — a integração Neon da Vercel normalmente fornece DATABASE_URL.
# Nunca comite a URL real do banco.
DATABASE_URL=

# Fallbacks opcionais para outros provedores PostgreSQL.
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# Segredo exclusivo para assinatura da sessão HttpOnly.
# Use pelo menos 32 bytes aleatórios em Preview e Production.
SESSION_SECRET=

# Segredo interno para compatibilidade com integrações antigas.
# Não é necessário para a conexão Neon nem para o login.
REMOTE_SYNC_KEY=
ALLOW_LEGACY_SYNC_KEY=false

# Use somente ao executar scripts/bootstrap_admin.py localmente/CI protegida.
# Prefira o prompt interativo; não comite valor real.
BOOTSTRAP_ADMIN_PASSWORD=

SMG_FRONTEND_DIR=frontend

# WhatsApp Business Cloud API.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=lembrete_mensalidade_arte_de_aprender
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
CRON_SECRET=
