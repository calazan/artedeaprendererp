# Neon/PostgreSQL — a integração Neon da Vercel normalmente fornece DATABASE_URL.
# Nunca comite a URL real do banco.
DATABASE_URL=

# Fallbacks opcionais para outros provedores PostgreSQL.
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# OBRIGATÓRIO: segredo exclusivo para assinatura da sessão HttpOnly.
# Use pelo menos 32 bytes aleatórios em Preview e Production. Sem ele o login falha fechado.
SESSION_SECRET=


# Use somente ao executar scripts/bootstrap_admin.py localmente/CI protegida.
# Prefira o prompt interativo; não comite valor real.
BOOTSTRAP_ADMIN_PASSWORD=

SMG_FRONTEND_DIR=frontend

# WhatsApp Business Cloud API.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=lembrete_mensalidade_arte_de_aprender
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
CRON_SECRET=


# Diagnóstico temporário de CSP. Em produção deixe false/ausente para política bloqueante.
CSP_REPORT_ONLY=false

# OBRIGATÓRIO antes de ativar o pré-cadastro: chave AES-256 em base64-url (32 bytes).
DATA_ENCRYPTION_KEY=
# Pré-cadastros rejeitados são apagados após este número de dias.
PREREG_REJECTED_RETENTION_DAYS=30
